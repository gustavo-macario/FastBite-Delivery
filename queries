--     30. [Stored Procedure] Motor de Bônus Automático
-- Crie uma Stored Procedure chamada CalcularBonusEntregador que receba como parâmetro de entrada o id_entregador. A procedure deve fazer o seguinte:

-- Calcular a média das notas (nota_entregador) desse profissional.

-- Contar quantas entregas concluídas ('Entregue') ele possui.

-- Se o entregador tiver uma média de notas maior ou igual a 4.5 E mais de 3 entregas, a procedure deve retornar a mensagem: 'Bônus de R$ 100,00 Aprovado'. Caso contrário, deve retornar: 'Critérios não atingidos'. 
-- (Pode retornar através de um SELECT simples dentro da procedure).

DELIMITER $$
create procedure CalcularBonusEntregador (in id_do_entregador INT)
BEGIN

declare media_entregador decimal(3,2);
declare qtde_entregador int;
 
select round(avg(nota_entregador),2), count(p.data_hora_entrega) into media_entregador, qtde_entregador
from avaliacoes a

join pedidos p on a.id_pedido = p.id_pedido

where status_pedido = 'Entregue'
and p.id_entregador = id_do_entregador;

if media_entregador >= 4.5 and qtde_entregador > 3 and media_entregador is not null
then
select 'Bônus de R$ 100,00 Aprovado' as resultado;
else 
select 'Critérios não atingidos';
end if;

end $$

DELIMITER ;

CALL CalcularBonusEntregador(1);
