-- 1. Ranking de Restaurantes (Window Function)
-- Qual é o restaurante que mais faturou (soma de valor_total dos pedidos com status 'Entregue') dentro de cada categoria? Retorne a categoria, o nome do restaurante, 
-- o faturamento total e o ranking dele (1, 2, 3...) particionado por categoria.
with total_res as (
select r.nome, r.categoria,
sum(p.valor_total) as total
 from restaurantes r

join pedidos p on r.id_restaurante = p.id_restaurante

where p.status_pedido = 'Entregue'

group by r.nome, r.categoria
),

maiores as (
select *,
DENSE_RANK() over (partition by categoria order by total desc) as ranking
 from total_res
 )
 
 select * from maiores
 where ranking = 1
 
 order by total desc;
 
--  2. Eficiência Logística
-- Qual é o tempo médio de entrega (em minutos) para cada tipo_veiculo? Considere apenas pedidos com status 'Entregue'.
with tempo_pedidos as (
SELECT p.id_pedido, e.tipo_veiculo,
TIMESTAMPDIFF(minute, p.data_hora_pedido, p.data_hora_entrega) as minutos
FROM pedidos p
JOIN entregadores e ON p.id_entregador = e.id_entregador
WHERE p.status_pedido = 'Entregue'

)

select tipo_veiculo, 
round(avg(minutos),2) as media
from tempo_pedidos

group by tipo_veiculo
order by media;

-- 3. Retenção de Clientes
-- Identifique os clientes que fizeram mais de 2 pedidos no mês de Novembro de 2023. Retorne o nome do cliente, a cidade e a quantidade exata de pedidos.
select c.nome, c.cidade,
count(p.id_pedido) as qtde_pedidos
 from clientes c 

join pedidos p on c.id_cliente = p.id_cliente

where p.data_hora_pedido >= '2023-11-01'
and p.data_hora_pedido < '2023-12-01'

group by c.id_cliente, c.nome, c.cidade
having count(p.id_pedido) > 2;

-- 4. Ticket Médio Cruzado
-- Calcule o Ticket Médio (média do valor_total) dos pedidos entregues, agrupado por estado do cliente.
select c.estado,
round(avg(p.valor_total), 2) as media
 from pedidos p
 
 join clientes c on p.id_cliente = c.id_cliente
 
 where p.status_pedido = 'Entregue'

 group by c.estado
 order by media desc;
 
--  5. O Problema do "Tempo de Espera"
-- Identifique os entregadores que tiveram um tempo de entrega (diferença entre data_hora_pedido e data_hora_entrega) superior a 45 minutos em pelo menos um pedido. Retorne o nome do entregador e o tipo de veículo.
select e.nome, e.tipo_veiculo, 
TIMESTAMPDIFF(minute, p.data_hora_pedido, p.data_hora_entrega) as minutos
 from entregadores e

join pedidos p on e.id_entregador = p.id_entregador

where p.status_pedido = 'Entregue'
and TIMESTAMPDIFF(minute, p.data_hora_pedido, p.data_hora_entrega) > 45

order by minutos desc;


-- 6. Análise de Risco Operacional
-- Qual é a taxa de cancelamento geral da plataforma? Crie uma query que retorne o total de pedidos, o total de pedidos cancelados e a porcentagem que os cancelamentos representam do total.
select count(*) as total,
count(case when p.status_pedido = 'Cancelado' then 1 end ) as total_cancelados,
round(count(case when p.status_pedido = 'Cancelado' then 1 end ) * 100.00
/
count(*),2) as taxa

from pedidos p;

-- 7. "Top of Mind"
-- Qual foi o prato (nome_prato da tabela itens_pedido) mais vendido em quantidade total de unidades (quantidade) para a categoria de restaurante 'Lanches'?
select ip.nome_prato,
sum(ip.quantidade) as quantidade
 from pedidos p
 
 join itens_pedido ip on p.id_pedido = ip.id_pedido
 join restaurantes r on p.id_restaurante = r.id_restaurante

where r.categoria = 'Lanches'

group by ip.nome_prato
order by quantidade desc
limit 1;

-- 8. Avaliação de Qualidade Tripla
-- Mostre os 3 restaurantes que possuem a pior média de avaliação (nota_restaurante), mas que têm pelo menos 2 pedidos avaliados. Retorne o nome do restaurante e a média da nota.
select r.nome,
avg(a.nota_restaurante) media
 from restaurantes r 

join pedidos p on r.id_restaurante = p.id_restaurante
join avaliacoes a on p.id_pedido = a.id_pedido

group by r.id_restaurante, r.nome
having count(a.id_avaliacao) >= 2
order by media asc
limit 3;


-- 9. Frequência de Compra
-- Para a cliente 'Ana Silva' (ID 1), mostre todos os pedidos entregues, a data do pedido e quantos dias se passaram entre cada pedido realizado por ela.

with dias_p as (
select c.nome, p.id_pedido, p.data_hora_pedido,
lag(p.data_hora_pedido) over (partition by p.id_cliente order by p.data_hora_pedido) as dias_lag
  from clientes c

join pedidos p on c.id_cliente = p.id_cliente 

where c.id_cliente = 1
and p.status_pedido = 'Entregue'
)

select nome, id_pedido, data_hora_pedido,
coalesce(datediff(data_hora_pedido, dias_lag),0) as dias_passados
 from dias_p;


-- 10. Curva ABC de Faturamento
-- Liste todos os clientes e o valor total gasto por eles. Adicione uma coluna calculando a soma acumulada do faturamento total da plataforma, ordenando do cliente que mais gastou para o que menos gastou.
with total_c as (
select c.id_cliente, c.nome,
sum(p.valor_total) as total
 from clientes c

join pedidos p on c.id_cliente = p.id_cliente

where p.status_pedido = 'Entregue'

group by c.id_cliente, c.nome
),

acumulado as (
select *,
sum(total) over (order by total desc) as soma_acumulada,
round(sum(total) over (order by total desc) 
/
sum(total) over (),2) as percentual_acumulado
from total_c
 
 order by total desc
 )
 
 select *,
 case
when percentual_acumulado <= 0.80 then 'A'
when percentual_acumulado <= 0.95 then 'B'
else 'C'
end as classe_abc
 from acumulado;


-- 11. Horário de Pico (Análise de Série Temporal)
-- Qual é o horário de pico absoluto da plataforma? Determine qual hora do dia (ex: 18h, 19h, 20h) possui o maior volume histórico de pedidos finalizados (status 'Entregue'). 
-- Retorne a hora isolada e a quantidade total de pedidos daquela hora.

with horas_p as (
select id_pedido, hour(data_hora_entrega) as horas from pedidos

where status_pedido = 'Entregue'
)

select horas,
count(id_pedido) as qtde
 from horas_p
 
 group by horas
 order by qtde desc
 limit 1;
 
 
--  12. Fidelidade Multi-Categoria (Contagem Distinta Condicional)
-- Queremos encontrar os clientes com paladar mais diversificado. Liste os clientes que já fizeram pedidos (Entregues) em pelo menos 3 categorias diferentes de restaurantes.
--  Retorne o nome do cliente e a quantidade de categorias distintas que ele já consumiu.
 
 select c.nome, count(distinct r.categoria) as qtde_categorias from clientes c
  
 join pedidos p on c.id_cliente = p.id_cliente
 join restaurantes r on p.id_restaurante = r.id_restaurante
 
 where p.status_pedido = 'Entregue'
 
 group by c.id_cliente, c.nome
 having count(distinct r.categoria) >= 3;
 
 
--  13. Impacto do Atraso na Avaliação (Agregação Cruzada)
-- Será que a demora destrói a nota do entregador? Calcule a média da nota_entregador dividida em dois grupos estritos: pedidos com tempo de entrega menor ou igual a 45 minutos, e pedidos com tempo superior a 45 minutos.
--  Retorne o nome do grupo e a média da nota.

with entregas_m as (
select *,
TIMESTAMPDIFF(minute, data_hora_pedido, data_hora_entrega) as minutos
 from pedidos 
)

select round(avg(a.nota_entregador),2) as media_nota,
case when minutos <= 45 then 'Menor Igual 45'
else 'Maior 45'
end as grupos
 from entregas_m em
 
 join avaliacoes a on em.id_pedido = a.id_pedido
 
 group by grupos
 order by media_nota desc; 
 
--  14. Crescimento Diário de Receita (Day-over-Day Growth)
-- Calcule a receita total diária (apenas pedidos 'Entregues') e use funções de janela para mostrar o crescimento ou queda percentual da receita em relação ao dia anterior. Retorne a data, a receita do dia e o percentual de variação.

with dias_p as (
select substr(data_hora_entrega, 1, 11) as dias,
sum(valor_total) as total
 from pedidos p

where p.status_pedido = 'Entregue'

group by substr(data_hora_entrega, 1, 11)
order by dias asc
),

dia_anterior as (
select dias, total,
lag(total) over (order by dias) as total_anterior
 from dias_p
)

select dias, total,
round(coalesce((total - total_anterior) 
/
nullif(total_anterior, 0),0), 2) as percentual
 from dia_anterior;
 
 
--  15. O Entregador "Perfeito" (Anti-Join e Filtros Excludentes)
-- A operação quer premiar a elite da frota. Identifique os entregadores que realizaram pelo menos 2 entregas no histórico, que nunca tiveram um pedido associado a eles cancelado na plataforma,
--  e que possuem a média de nota_entregador exatamente igual a 5.0.

select e.id_entregador, e.nome, round(avg(a.nota_entregador),1) as media from entregadores e

join pedidos p on e.id_entregador = p.id_entregador
join avaliacoes a on p.id_pedido = a.id_pedido

where (p.status_pedido = 'Entregue')
and
(not exists (
select 1 
from pedidos p2
where p2.id_entregador = e.id_entregador
and p2.status_pedido = 'Cancelado'
) )

group by e.id_entregador, e.nome
having (avg(a.nota_entregador) = 5.0) and (count(data_hora_entrega) >= 2)
order by e.nome;


-- 16. Receita: Novos vs. Recorrentes (Classificação Dinâmica)
-- Precisamos saber de onde vem o nosso dinheiro. Classifique cada pedido 'Entregue' como 'Primeiro Pedido' (a primeira compra histórica de um cliente) ou 'Recorrente' (qualquer compra subsequente daquele mesmo cliente). 
-- Em seguida, calcule o faturamento total da plataforma gerado por 'Primeiros Pedidos' versus 'Recorrentes'.

with ordenando as (
select p.id_cliente, c.nome, p.valor_total, p.data_hora_entrega,
row_number() over (partition by c.id_cliente order by p.data_hora_entrega asc) as datas_pedidos
from pedidos p

 join clientes c on p.id_cliente = c.id_cliente

 where status_pedido = 'Entregue'
 )
 
 select 
 sum(case when datas_pedidos = 1 then valor_total ELSE 0 END) as total_primeiros_pedidos,
 sum(case when datas_pedidos != 1 then valor_total ELSE 0 END) as total_pedidos_recorrentes
 from ordenando;
 
--  17. Sensibilidade à Taxa de Entrega (Cálculo Proporcional)
-- Existem restaurantes onde o cliente paga caro só para o prato chegar. Qual restaurante possui a maior proporção média entre a taxa_entrega e o valor_total do pedido? 
-- Retorne o nome do restaurante e essa proporção percentual média (ex: a taxa representa 15% do valor do pedido).

select r.nome, round(AVG(r.taxa_entrega / p.valor_total) * 100.00, 2) as taxa from pedidos p

join restaurantes r on p.id_restaurante = r.id_restaurante

group by r.id_restaurante
order by taxa desc;

-- 18. Detecção de Anomalia em Volumes (Outliers Internos)
-- O time de fraudes suspeita de pedidos com quantidades irreais. Encontre os itens de pedido (nome_prato) cuja quantidade solicitada em um único pedido seja maior que o dobro (2x) 
-- da média histórica de quantidade vendida por pedido para aquele prato específico em toda a base.
with soma_p as (
select p.id_pedido,nome_prato, sum(ip.quantidade) as soma from pedidos p

join itens_pedido ip on p.id_pedido = ip.id_pedido

group by p.id_pedido,nome_prato
),

soma_historica as (
select nome_prato, avg(quantidade) as soma from itens_pedido

group by nome_prato
)

select sp.nome_prato from soma_p sp

join soma_historica sh on sp.nome_prato = sh.nome_prato

where sp.soma > (sh.soma * 2);


-- 19. Ticket Médio Ponderado por Nota (Matemática Condicional)
-- Existe correlação entre o quanto o cliente gasta e a nota que ele dá ao restaurante? Calcule o Ticket Médio (média do valor_total) agrupado exatamente pelas notas recebidas pelos restaurantes (1, 2, 3, 4 e 5). 
-- Considere apenas pedidos entregues que possuam avaliação do restaurante registrada.

select a.nota_restaurante,
round(avg(p.valor_total), 2) as media
 from pedidos p

join avaliacoes a on p.id_pedido = a.id_pedido
 
 where (p.status_pedido = 'Entregue')

group by a.nota_restaurante
order by media desc;


-- 20. Churn Precoce (Análise Relativa de Inatividade)
-- Considerando a data do último pedido registrado em toda a plataforma como a nossa "data atual" de análise, identifique os clientes que realizaram seu primeiro e único pedido, 
-- mas já não compram há mais de 5 dias (em relação a essa "data atual"). Retorne o nome do cliente, a data do único pedido e há quantos dias ele está inativo.

with clientes_1_pedido as (
select p.id_cliente, min(data_hora_entrega) as min, count(id_pedido)
 from pedidos p
 
group by p.id_cliente
having count(id_pedido) = 1
)

select c.nome, datediff((select max(data_hora_entrega) from pedidos), c1.min) as conta
from clientes_1_pedido c1

join clientes c on c1.id_cliente = c.id_cliente

where datediff((select max(data_hora_entrega) from pedidos), c1.min) > 5;

-- 21. Análise de Cesta de Compras (Market Basket Analysis)
-- Quais pratos são mais consumidos juntos? Escreva uma query que identifique os pares de pratos (nome_prato) que aparecem juntos no mesmo pedido com maior frequência. 
-- Retorne o nome do Prato A, o nome do Prato B e a quantidade de vezes que eles foram comprados no mesmo id_pedido. (Atenção para não duplicar o par invertendo a ordem: A-B é o mesmo que B-A).
select ip.nome_prato, ip2.nome_prato, count(*) as frequencia from itens_pedido ip 

join itens_pedido ip2 on ip.id_pedido = ip2.id_pedido

where ip.nome_prato < ip2.nome_prato

group  by ip.nome_prato, ip2.nome_prato

order by frequencia desc;

-- 22. Azar Consecutivo (Janelas de Cancelamento)
-- Identifique os clientes que tiveram 2 ou mais pedidos seguidos com o status 'Cancelado'. Use funções de janela (como LAG ou LEAD) para verificar a sequência cronológica dos pedidos de cada cliente.

with status_anterior as (
select p.id_cliente, c.nome, p.status_pedido,
lag(status_pedido) over (partition by id_cliente order by data_hora_pedido) as anterior
 from pedidos p 
 
 join clientes c on p.id_cliente = c.id_cliente
 
)

select distinct nome from status_anterior

where status_pedido = anterior
and status_pedido = 'Cancelado'; 


-- 23. Média Móvel de Tempo de Entrega (Rolling Average Logs)
-- Vamos monitorar o cansaço do entregador 'Carlos Moto' (ID 1). Calcule a média móvel do tempo de entrega (em minutos) dele, considerando o pedido atual e os 2 pedidos imediatamente anteriores a ele.
--  Retorne o ID do pedido, a data/hora e a média móvel de tempo.

with minutos_e as (
select e.id_entregador, p.id_pedido, p.data_hora_entrega, timestampdiff(minute, data_hora_pedido, data_hora_entrega) as minutos from pedidos p 

join entregadores e on p.id_entregador = e.id_entregador

where e.id_entregador = 1
)

select *,
round(avg(minutos) over (partition by id_entregador order by data_hora_entrega ROWS BETWEEN 2 PRECEDING AND CURRENT ROW),2) as media_movel
 from minutos_e;


-- 24. Market Share por Categoria (Percentual de Participação)
-- Descubra a fatia de mercado de cada categoria gastronômica. Retorne a categoria, o faturamento total daquela categoria (pedidos entregues)
--  e o percentual que esse valor representa sobre o faturamento total absoluto de toda a plataforma (Market Share).

with total_plataforma as (
select sum(valor_total) as total_p from pedidos p
where p.status_pedido = 'Entregue'
),

total_categorias as (
select r.categoria, sum(valor_total) as total_categoria from pedidos p

join restaurantes r on p.id_restaurante = r.id_restaurante

where p.status_pedido = 'Entregue'

group by r.categoria
)

select categoria,total_categoria,
round(total_categoria / (select total_p from total_plataforma),2) as percentual

 from total_categorias

order by percentual desc;


-- 25. Receita por Safra (Análise de Cohort Mensal)
-- Defina o "Mês de Safra" (Cohort) de um cliente como o mês em que ele realizou seu primeiro pedido na plataforma. Calcule o faturamento total gerado no sistema agrupado por essas Safras. 
-- Retorne o Mês da Safra e o faturamento total correspondente gerado por esses clientes em toda a vida útil deles.

with primeiro_pedido as (
select id_cliente,  min(data_hora_pedido) as primeira from pedidos p 

group by id_cliente
)

select substr(pp.primeira,1 , 7) as mes_safra, sum(p.valor_total) as total from primeiro_pedido pp

join pedidos p on pp.id_cliente = p.id_cliente

group by  substr(pp.primeira,1 , 7);


-- 26. Consistência Logística (Gaps & Islands Avançado)
-- Queremos premiar a assiduidade. Descubra qual entregador trabalhou (ou seja, realizou pelo menos uma entrega com sucesso) no maior número de dias consecutivos.
--  Retorne o nome do entregador e o número máximo de dias ininterruptos trabalhados.

with datas_e as (
select distinct e.id_entregador, e.nome, date(p.data_hora_entrega) as dias
 from pedidos p

join entregadores e on p.id_entregador = e.id_entregador

where p.status_pedido = 'Entregue'
),

dia_anterior as (

select id_entregador, nome, dias,
lag(dias) over (partition by id_entregador order by dias) as data_antiga
 from datas_e
),

diferenca_dias as (
select id_entregador, nome,dias,data_antiga,
case 
when coalesce(TIMESTAMPDIFF(day, data_antiga, dias), 0) != 1 then 1
else 0
end as diferenca 
from dia_anterior
),

soma_dias as (
select id_entregador, nome, sum(diferenca) over (partition by id_entregador order by dias) as soma
 from diferenca_dias
 )

select id_entregador, nome, count(*) qtde from soma_dias

group by id_entregador, nome, soma
order by qtde desc 
limit 1 ;


-- 27. Fechamento de Faturamento MTD (Month-to-Date)
-- Para o restaurante 'Burger King' (ID 1), construa um relatório financeiro diário. Retorne a data (apenas o dia), a receita gerada naquele dia específico e a receita acumulada do mês (MTD - Month-to-Date).
-- A soma acumulada deve ser "resetada" automaticamente se houver virada de mês (embora nossa amostra seja em novembro, sua query deve prever isso usando PARTITION BY).

with total_dia as (
select substr( data_hora_entrega,1, 10) as dias, sum(valor_total) as total_dia from pedidos 

where id_restaurante = 1

group by substr( data_hora_entrega,1, 10)
)

select right(dias, 2) as dias, total_dia, 
sum(total_dia) over (partition by substr(dias, 1, 7) order by dias ) as acumulado_mes
 from total_dia;
 
 
--  28. Cross-Join Simples (Garantindo Zeros no Relatório)
-- A diretoria quer ver todos os restaurantes, independentemente de terem vendido ou não em uma data específica. Crie uma query usando CROSS JOIN para cruzar todos os Restaurantes com os meses disponíveis nos registros de pedidos. 
-- Mostre o nome do restaurante, o mês e o faturamento. Se o restaurante não faturou nada naquele mês, mostre 0 (e não NULL).
 
 with mes as (
SELECT DISTINCT substr(p.data_hora_entrega,1,7) as meses
from pedidos p
where p.data_hora_entrega is not null

)

select m.meses, r.nome, coalesce(sum(p.valor_total),0) as soma from restaurantes r 
cross join mes m
left join pedidos p on r.id_restaurante = p.id_restaurante
and substr(p.data_hora_entrega,1,7) = m.meses

group by m.meses, r.nome;


